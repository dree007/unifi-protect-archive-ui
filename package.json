{
  "name": "unifi-archive-ui",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "publication:check": "node scripts/publication-check.mts",
    "build": "next build && node scripts/prepare-standalone.mts",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "exec tsx --conditions=react-server scripts/migrate.mts",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio --host 127.0.0.1",
    "db:wait": "node scripts/wait-for-postgres.mts",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "archive:scan": "exec tsx --conditions=react-server scripts/index-archive.mts",
    "protect:sync-cameras": "exec tsx --conditions=react-server scripts/protect-sync-cameras.mts",
    "protect:collect": "exec tsx --conditions=react-server scripts/protect-collect.mts",
    "archive:reconcile": "exec tsx --conditions=react-server scripts/reconcile-archive.mts",
    "media:check": "exec tsx --conditions=react-server scripts/media-check.mts",
    "worker:run": "exec tsx --conditions=react-server scripts/worker-run.mts",
    "test:docker": "node tests/docker/run.mts",
    "build:cli": "node scripts/build-cli.mts && node scripts/prepare-notices.mts",
    "worker:build": "npm run build:cli",
    "worker:start": "exec node --enable-source-maps dist/cli/worker-run.mjs",
    "test:e2e:prepare": "exec tsx --conditions=react-server e2e/prepare.mts",
    "test:e2e": "npm run test:e2e:prepare && playwright test",
    "release:build": "node scripts/release/build.mts",
    "release:publish": "node scripts/release/publish.mts",
    "release:native": "node scripts/release/native-bundle.mts",
    "release:native:check": "node scripts/release/validate-native.mts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "radix-ui": "^1.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.2",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "license": "AGPL-3.0-only"
}
