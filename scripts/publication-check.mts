import { createHash } from "node:crypto";
import { execFileSync } from "node:child_process";
import { readFile } from "node:fs/promises";
import path from "node:path";

import policy from "./publication-policy.json" with { type: "json" };

export function isPublicPath(file: string): boolean {
  if (policy.excluded.some((item) => item.endsWith("/") ? file.startsWith(item) : file === item)) return false;
  return policy.publicFiles.includes(file)
    || policy.publicDirectories.some((directory) => file.startsWith(`${directory}/`))
    || policy.publicDocs.some((name) => file === `docs/${name}`);
}

/** Narrow publication checks, not a general secret scanner or a history sanitizer. */
export function publicationIssues(file: string, content: Buffer): string[] {
  const issues: string[] = [];
  if (/(^|\/)\.env(?:\.|$)/.test(file) && file !== ".env.example") issues.push("tracked private environment file");
  if (/\.(?:dump|backup|bak|sqlite3?|db|mp4|mov|mkv|png|jpe?g|webp|log)$/i.test(file)) issues.push("binary/data artifact requires explicit publication review");
  const text = content.toString("utf8");
  if (file === policy.testKey && createHash("sha256").update(content).digest("hex") !== policy.testKeySha256) issues.push("documented test key changed; review fixture provenance");
  if (file !== policy.testKey && (/\.key$/i.test(file) || /-----BEGIN (?:[A-Z ]+)?PRIVATE KEY-----[\s\S]+?-----END (?:[A-Z ]+)?PRIVATE KEY-----/.test(text))) issues.push("private key outside documented test fixture");
  if (/(?:glpat-[A-Za-z0-9_-]{15,}|gh[pousr]_[A-Za-z0-9]{30,}|AKIA[0-9A-Z]{16})/.test(text)) issues.push("token-shaped value requires secret review");
  if (!isPublicPath(file)) return issues;
  // The checker necessarily declares the prohibited phrases as rule literals.
  if (file !== "scripts/publication-check.mts") {
    if (/generated by (?:chatgpt|claude|codex)|(?:codex|claude code) implementation|vibe coding|\bprompt\s+\d+\b/i.test(text)) issues.push("development-assistant/prompt artifact in public source");
    if (/\bUniFi Archive\b/.test(text)) issues.push("old visible product name");
  }
  return issues;
}

export async function checkPublication(root = process.cwd(), suppliedFiles?: string[]) {
  const files = suppliedFiles ?? execFileSync("git", ["ls-files", "-z"], { cwd: root, encoding: "utf8" }).split("\0").filter(Boolean);
  const findings: { file: string; issues: string[] }[] = [];
  for (const file of files) {
    const issues = publicationIssues(file, await readFile(path.join(root, file)));
    if (issues.length) findings.push({ file, issues });
  }
  return { files: files.length, publicFiles: files.filter(isPublicPath).length, findings };
}

if (process.argv[1] && path.resolve(process.argv[1]) === path.resolve(import.meta.filename)) {
  const supplied = process.env.PUBLICATION_FILE_LIST
    ? JSON.parse(await readFile(process.env.PUBLICATION_FILE_LIST, "utf8")) as string[] : undefined;
  const result = await checkPublication(process.cwd(), supplied);
  for (const item of result.findings) console.error(`${item.file}: ${item.issues.join("; ")}`);
  console.log(`Publication hygiene: ${result.files} tracked/candidate files, ${result.publicFiles} intended public files, ${result.findings.length} findings.`);
  if (result.findings.length) process.exitCode = 1;
}
