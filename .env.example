# Unifi Protect Archive UI – configuration
#
# Self-hosted with Docker (docs/selfhosting.md):
#   cp .env.example .env && chmod 600 .env
#   set POSTGRES_PASSWORD and NAS_ARCHIVE_HOST_PATH, then: docker compose up -d
# Everything else is optional. Never commit .env – it holds secrets.
#
# Values containing $, #, spaces or quotes: wrap them in SINGLE quotes, e.g. POSTGRES_PASSWORD='a$b#c'.

# === Required ===================================================================================

# Password of the bundled PostgreSQL. Set once before the first start; generate e.g. with
#   openssl rand -hex 24
# Any character works (it is never put into a URL). Changing it later needs ALTER USER (docs).
POSTGRES_PASSWORD=

# The UniFi Protect archive on this host (day folders with MP4 exports, e.g. the NAS mount).
# Mounted READ-ONLY at /archive; the containers do not start if the path does not exist.
NAS_ARCHIVE_HOST_PATH=

# === Optional ===================================================================================

# Direct LAN access by default: http://<docker-host-ip>:3100.
# 0.0.0.0 binds ALL IPv4 interfaces, not only the home LAN. No app login or HTTPS.
# Do not forward this port from the router or expose it to the public Internet.
# Use 127.0.0.1 behind an authenticating HTTPS proxy, or the host's specific IPv4 address.
UNIFI_ARCHIVE_BIND_IP=0.0.0.0
UNIFI_ARCHIVE_PORT=3100

# Maintainer/local release-candidate override only; ordinary users keep the versioned GHCR default.
# UNIFI_ARCHIVE_IMAGE=unifi-protect-archive-ui:1.0.0-rc.1

# HTTPS URL of the complete source corresponding to the running application version.
# Official images already link their own release source; set this if you modify or rebuild the app.
APP_SOURCE_URL=

# Time zone for "today", day boundaries and all displayed times (IANA name).
APP_TIME_ZONE=Europe/Berlin

# --- UniFi Protect (optional; without it: NAS-only operation) ---------------------------------
# auto: use Protect when URL and API key are set · true: Protect required · false: off
PROTECT_COLLECTOR_ENABLED=auto
# Console address as seen from the containers, including https://, e.g. https://192.168.1.1
UNIFI_PROTECT_URL=
# API key from UniFi (Settings → Control Plane → Integrations). Secret.
UNIFI_PROTECT_API_KEY=
# false: accept the console's self-signed certificate – for the Protect connection only.
UNIFI_PROTECT_TLS_VERIFY=true

# Advanced settings (worker intervals, NAS mount checks, database name, ...) are optional and
# listed in docs/selfhosting.md; add them here only when you need them.
